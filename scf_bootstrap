#!/bin/bash

# ==============================================================================
# 腾讯云 SCF (云函数) 默认启动文件
# 提示：此文件必须保存为 Unix (LF) 换行格式，而在 Windows 下编辑容易变成 CRLF 进而引发 exec format error
# ==============================================================================

# 1. 注入生产环境变量
export NODE_ENV=production

# 2. 腾讯云 SCF 默认对外监听端口一般是 9000，但您的 Express 已经被配置为极简、规范的 3000 端口
# 您可以在【腾讯云控制台】中，将“监听端口”配置项由 9000 改为 3000，或者在此行启动 Node.js
# 启动 compiled 生产包：
node dist/server.cjs
